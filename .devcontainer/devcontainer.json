{
  "name": "unified_robot_interface",

  // Builds the image locally. A prebuilt one is published by
  // .github/workflows/devcontainer-image.yaml on every push to main that
  // touches .devcontainer/**; to use it instead, replace "build" with:
  // "image": "ghcr.io/isri-aist/unified_robot_interface-devcontainer:latest",
  "build": { "dockerfile": "Dockerfile", "target": "devcontainer" },

  "mounts": [
    // TODO: check and delete
    // "type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix,consistency=cached",
    "source=${localEnv:HOME}/.Xauthority,target=/home/vscode/.Xauthority,type=bind",

    // Forward your git identity.
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/vscode/.gitconfig,type=bind"
  ],

  "runArgs": [
    "--network=host",
    "--cap-add=sys_nice",
    "--security-opt",
    "seccomp=unconfined",
    "--ulimit=rtprio=99:99",
    "--ulimit=memlock=100000000000:100000000000",
    "--device=/dev/dri"

    // Foward device path for triorb. Uncomment if needed.
    // "--device=/dev/serial/by-id/usb-TriOrb_TriOrb_Device_389999633556-if00:/dev/triorb"
  ],

  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "ROS_DISTRO": "jazzy"
  },

  "remoteUser": "vscode",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/unified_robot_interface,type=bind",
  "workspaceFolder": "/home/vscode/unified_robot_interface",

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "twxs.cmake",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack"
      ]
    }
  }
}
